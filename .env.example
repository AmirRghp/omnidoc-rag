# ==============================================================================
# OmniDoc RAG — Environment Configuration Template
# ==============================================================================

# Server & Environment
ENVIRONMENT=development
APP_PORT=8000
APP_HOST=0.0.0.0
API_KEY=dev_insecure_local_key_replace_in_prod

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Optional: Leave empty for local development (runs unauthenticated on HTTP).
# Set only when connecting to an authenticated remote instance or Qdrant Cloud.
QDRANT_API_KEY=
# Optional boolean (true/false). When omitted, automatically defaults to false
# on localhost/127.0.0.1, preventing unintended SSL errors.
QDRANT_HTTPS=

# In-Memory Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Leave empty for local development (Docker Compose runs without auth).
# Set only in production when Redis requires password authentication.
REDIS_PASSWORD=

# Local LLM Serving (vLLM OpenAI-Compatible Endpoint)
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=dummy-local-key
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_HOST=http://localhost:3000
